# Server Configuration
PORT=3000
NODE_ENV="production"

# GEMINI_API_KEY: Required for Gemini AI agreement generator & smart assistant.
# On Hostinger, set this in your Node.js Environment Variables.
GEMINI_API_KEY=""

# APP_URL: Domain where this portal is hosted (e.g. https://portal.redflaghomes.in)
APP_URL="https://portal.redflaghomes.in"

# Email Configuration (Resend or SMTP)
# Option A: Resend API Key (Recommended)
RESEND_API_KEY=""

# Option B: Standard SMTP Mail Server (e.g., Hostinger Titan Mail / Google Workspace)
SMTP_HOST="smtp.titan.email"
SMTP_PORT=587
SMTP_USER="agreements@redflaghomes.in"
SMTP_PASS=""
EMAIL_FROM="Red Flag Homes <agreements@redflaghomes.in>"

